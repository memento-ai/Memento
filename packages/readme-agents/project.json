{
    "name": "@memento-ai/readme-agents",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/readme-agents/src",
    "projectType": "library",
    "tags": [],
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{options.outputPath}"],
            "options": {
                "command": "bun build packages/readme-agents/index.ts --outdir dist/readme-agents --target node"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "test": { "executor": "@nx-bun/nx:test", "options": { "smol": false, "bail": true, "bun": false } },
        "type-check": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/out-tsc/packages/readme-agents",
                "main": "packages/readme-agents/index.ts",
                "tsConfig": "packages/readme-agents/tsconfig.json",
                "noEmit": true
            }
        }
    }
}
