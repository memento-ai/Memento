{
    "name": "@memento-ai/ingest",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/ingest/src",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{options.outputPath}"],
            "options": {
                "command": "bun build apps/ingest/src/ingest.ts --outdir dist/ingest --target node"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "serve": {
            "executor": "@nx-bun/nx:run",
            "defaultConfiguration": "development",
            "options": {
                "buildTarget": "ingest:build",
                "tsConfig": "apps/ingest/tsconfig.app.json",
                "bun": true,
                "smol": false
            }
        },
        "test": {
            "executor": "@nx-bun/nx:test",
            "options": {
                "smol": false,
                "bail": true,
                "tsConfig": "apps/ingest/tsconfig.json",
                "bun": true
            }
        },
        "type-check": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/out-tsc/apps/ingest",
                "main": "apps/ingest/src/ingest.ts",
                "tsConfig": "apps/ingest/tsconfig.json",
                "noEmit": true
            }
        }
    }
}
