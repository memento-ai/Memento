{
    "name": "@memento-ai/select-similar-mems",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/select-similar-mems/src",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{options.outputPath}"],
            "options": {
                "command": "bun build apps/select-similar-mems/src/main.ts --outdir dist/select-similar-mems --target node"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "serve": {
            "executor": "@nx-bun/nx:run",
            "defaultConfiguration": "development",
            "options": {
                "buildTarget": "select-similar-mems:build",
                "tsConfig": "apps/select-similar-mems/tsconfig.app.json",
                "bun": true,
                "smol": false
            }
        },
        "test": {
            "executor": "@nx-bun/nx:test",
            "options": {
                "smol": false,
                "bail": true,
                "tsConfig": "apps/select-similar-mems/tsconfig.json",
                "bun": true
            }
        },
        "type-check": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/out-tsc/apps/select-similar-mems",
                "main": "apps/select-similar-mems/src/main.ts",
                "tsConfig": "apps/select-similar-mems/tsconfig.json",
                "noEmit": true
            }
        }
    }
}
