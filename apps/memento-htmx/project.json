{
    "name": "@memento-ai/memento-htmx",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/memento-htmx/src",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{options.outputPath}"],
            "options": {
                "command": "bun build apps/memento-htmx/src/main.ts --outdir=dist/memento-htmx --target node"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "serve": {
            "executor": "nx:run-commands",
            "options": { "command": "bun run src/main.ts", "cwd": "apps/memento-htmx" }
        },
        "test": {
            "executor": "@nx-bun/nx:test",
            "options": {
                "smol": false,
                "bail": true,
                "tsConfig": "apps/memento-htmx/tsconfig.json",
                "bun": true
            }
        },
        "type-check": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/out-tsc/apps/memento-htmx",
                "main": "apps/memento-htmx/src/main.ts",
                "tsConfig": "apps/memento-htmx/tsconfig.json",
                "noEmit": true
            }
        }
    }
}
